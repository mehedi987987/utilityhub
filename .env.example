# Optional: API keys for the tools that call external AI services.
# Every other tool works fully offline in the browser without any of these.
#
# Copy this file to .env.local and fill in the values you have.
# Never commit .env.local — these are secrets and are only read on the server.

# Remove Background tool (https://www.remove.bg/api)
# Comma-separated list; the server rotates to the next key on 402/429.
REMOVE_BG_API_KEYS=

# Image Enhancer — AI mode. Any one of these is enough; the server tries them in order.
CLIPDROP_API_KEY=
DEEPAI_API_KEY=
PIXELCUT_API_KEY=

# Public base URL, used for sitemap.xml and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://workgate.example.com

# ---------------------------------------------------------------------------
# Adsterra (optional)
# ---------------------------------------------------------------------------
# Public ad keys — these ship to the browser and are not secrets.
# Leave any of them blank and that slot simply does not render, so the site
# works normally before your Adsterra account is approved.
#
# Get them from Adsterra -> Websites -> your site -> Get code.
# Each banner SIZE needs its own key.

NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_MOBILE_KEY=
NEXT_PUBLIC_ADSTERRA_RECTANGLE_KEY=

# Native Banner unit id (the "container-xxxx" script)
NEXT_PUBLIC_ADSTERRA_NATIVE_ID=

# Social Bar key (docked strip). Popunder is deliberately not wired up.
NEXT_PUBLIC_ADSTERRA_SOCIAL_KEY=

# Master kill switch for every ad slot
NEXT_PUBLIC_ADS_ENABLED=true
