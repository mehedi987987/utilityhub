# Optional: API keys for the tools that call external AI services.
# Every other tool works fully offline in the browser without any of these.
#
# Copy this file to .env.local and fill in the values you have.
# Never commit .env.local — these are secrets and are only read on the server.

# Remove Background tool (https://www.remove.bg/api)
# Comma-separated list; the server rotates to the next key on 402/429.
REMOVE_BG_API_KEYS=

# Image Enhancer — AI mode. Any one of these is enough; the server tries them in order.
CLIPDROP_API_KEY=
DEEPAI_API_KEY=
PIXELCUT_API_KEY=

# Public base URL, used for sitemap.xml and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://workgate.example.com
